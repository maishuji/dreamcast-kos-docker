# Add GDB to the toolchain image supplied by build_dc_toolchain_image.py.
ARG base_image=alpine:latest
FROM ${base_image}

ARG platform=dreamcast
ARG profile=stable

RUN mkdir -p /opt/toolchains/dc
# The build context is the KallistiOS source checkout.
COPY . /opt/toolchains/dc/kos

# Build and install GDB for the selected toolchain profile.
RUN cd /opt/toolchains/dc/kos/utils/kos-chain \
    && make gdb platform=$platform toolchain_profile=$profile \
    && rm -rf /opt/toolchains/dc/kos
